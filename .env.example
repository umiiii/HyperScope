# Railway Postgres 会提供这个连接串；本地开发时填写本地 PostgreSQL URL。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hyperscope
APP_URL=http://localhost:3000

# 运行 `npm run vapid:generate` 生成一次并长期保存。
# subject 是推送服务管理员的联系 URI，推荐填写真实邮箱。
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 默认每 60 秒检查一次，读取主永续 DEX 与全部 HIP-3 builder DEX。
MONITOR_INTERVAL_MS=60000
MAX_MONITORED_ADDRESSES=40

# 同一地址、同一 ticker、同一方向在这个窗口内只推送一次；设为 0 则每次变动都推送。
PUSH_DEDUP_WINDOW_MS=600000
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
